//@version=6
indicator("BreakBlock Market Structure [EP.1-5 + DayTrade + Reaper]", "BreakBlock", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ────────────────────────────────────────────────────────────────────────────
// THE POWER OF BREAKBLOCK — รวมเนื้อหา EP.01–EP.05 เป็นอินดิเคเตอร์เดียว
//   EP.01  Market Structure Basic   : HH/HL/LH/LL + Internal/External
//   EP.02  Market Structure Advance : Valid Pullback + Inducement (IDM)
//   EP.03  Strong Swing / BOS / CHoCH (CHoCH ยืนยันด้วยการปิดแท่งทะลุไส้)
//   EP.04  MSS + POI Zone + SR Shadow + BreakBlock
//   EP.05  Real BreakBlock (ต้องมี FVG) + CHoCH Retest + Fibo Target 4.123 / 6
//   Breakblock_S : Pattern Reversal W/M (ฟิลเตอร์ไหล่ 50%) + Re-Acc/Re-Dist + Fibo 300/400/600%
//   Day Trade    : Liquidity BSL/SSL + EQH/EQL + Overlap ≥2 = BREAKBLOCK แท้
//   Reaper Model : Phase A (BOS) → Phase B (Valid Pullback โดนเคลียร์ = Stoploss Retail)
//                  → Phase C (entry ที่ Breakblock ใต้/เหนือ Stoploss Retail)
// ดูรายละเอียดการตีความกฎแต่ละข้อใน docs/PLAN.md ของ repo
// ────────────────────────────────────────────────────────────────────────────

// ═════════════════════════ INPUTS ═════════════════════════
g1 = "Structure (EP.1-3)"
g2 = "MSS / POI (EP.4)"
g3 = "BreakBlock Zones (EP.4-5)"
g4 = "SR Shadow (EP.4)"
g5 = "Fibo Targets (EP.5)"
g6 = "Dashboard / Signals"

useCloseBreak = input.bool(false, "Swing break ใช้ราคาปิด (close)", tooltip = "EP.3: การยืนยัน swing valid pullback ใช้ไส้ (wick) ได้ — เปิดตัวเลือกนี้ถ้าต้องการให้เข้มขึ้นแบบ EP.2", group = g1)
confClose     = input.bool(true,  "ยืนยัน MSS/CHoCH เมื่อปิดแท่งเท่านั้น", tooltip = "กันสัญญาณกระพริบระหว่างแท่ง realtime", group = g1)
showSwing     = input.bool(true,  "แสดง Label HH / HL / LH / LL", group = g1)
showInternal  = input.bool(false, "แสดง Internal swing (สวนเทรนด์)", tooltip = "EP.1: โครงสร้างรองที่ซ้อนอยู่ใน leg ของ External", group = g1)
showIDM       = input.bool(true,  "แสดงเส้น IDM (Inducement)", group = g1)
showBOS       = input.bool(true,  "แสดงเส้น BOS", group = g1)
showCHoCH     = input.bool(true,  "แสดงเส้น CHoCH + ระดับเฝ้าระวัง", group = g1)
colBull       = input.color(color.teal,   "Bull", group = g1, inline = "c1")
colBear       = input.color(color.red,    "Bear", group = g1, inline = "c1")
colIdm        = input.color(color.orange, "IDM",  group = g1, inline = "c1")

showMSS = input.bool(true, "แสดงเส้น MSS", group = g2)
showPOI = input.bool(true, "แสดง POI Zone (กล่อง + เส้นกลาง 50%)", group = g2)
colPoi  = input.color(color.purple, "สี POI", group = g2)

showBB     = input.bool(true, "แสดงโซน BreakBlock", group = g3)
requireFVG = input.bool(true, "Real BreakBlock: ต้องมี FVG (EP.5)", tooltip = "โซนที่ leg ต้นกำเนิดไม่มี FVG จะถูกตัดทิ้ง", group = g3)
maxBB      = input.int(8, "จำนวนโซนสูงสุด", minval = 1, maxval = 20, group = g3)
maxOvl     = input.int(4, "Overlap สูงสุดก่อนลบโซน", minval = 1, maxval = 10, tooltip = "Day Trade: ทะลุ 1 ครั้ง = Breaker Block, ทะลุ ≥2 = BREAKBLOCK แท้ — โซนแสดงตัวนับ ×N", group = g3)
zoneAge    = input.int(400, "อายุโซนสูงสุด (แท่ง)", minval = 50, maxval = 2000, group = g3)
colBBBull  = input.color(color.teal, "โซน Bull", group = g3, inline = "c3")
colBBBear  = input.color(color.red,  "โซน Bear", group = g3, inline = "c3")

showSR   = input.bool(true, "แสดงแถบ SR Shadow", group = g4)
srMinAtr = input.float(0.1, "ความกว้างขั้นต่ำ (xATR14)", minval = 0.0, step = 0.05, group = g4)
maxSR    = input.int(5, "จำนวนแถบสูงสุด", minval = 1, maxval = 15, group = g4)
colSR    = input.color(color.silver, "สี SR Shadow", group = g4)

showFib      = input.bool(true,  "แสดง Fibo Target หลัง CHoCH", group = g5)
fibPreset    = input.string("4.123 / 6 (EP.5)", "ชุดเป้าหมาย Fibo", options = ["4.123 / 6 (EP.5)", "300 / 400 / 600% (W/M)"], group = g5)
showMinorFib = input.bool(false, "แสดงระดับรอง 4.618 / 6.444 / 6.918 (เฉพาะชุด EP.5)", group = g5)
colFib       = input.color(color.orange, "สี Fibo", group = g5)

showSignals = input.bool(true, "แสดงสัญลักษณ์สัญญาณบนชาร์ต", group = g6)
showDash    = input.bool(true, "แสดง Dashboard", group = g6)
htf1        = input.timeframe("60",  "HTF Bias 1", group = g6)
htf2        = input.timeframe("240", "HTF Bias 2", group = g6)
dashPosS    = input.string("top_right", "ตำแหน่ง Dashboard", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = g6)

g7 = "Liquidity (Day Trade)"
showLiq = input.bool(true, "แสดงเส้น BSL / SSL (สวิง 3 แท่งรวมไส้)", group = g7)
showEQ  = input.bool(true, "แสดง EQH / EQL", group = g7)
maxLiq  = input.int(6, "จำนวนเส้นต่อฝั่งสูงสุด", minval = 1, maxval = 15, group = g7)
eqTol   = input.float(0.25, "ค่าเผื่อ EQH/EQL (xATR14)", minval = 0.0, step = 0.05, group = g7)
colLiq  = input.color(color.gray, "สีเส้น Liquidity", group = g7)

g8 = "Reaper Model / Patterns"
showReaper = input.bool(true, "แสดงเส้น Stoploss Retail + สัญญาณ Reaper", tooltip = "Phase A: BOS / Phase B: Valid Pullback โดนเคลียร์ = Stoploss Retail / Phase C: entry ที่ BreakBlock ใต้-เหนือเส้นนี้", group = g8)
showWM     = input.bool(true, "ตรวจ Pattern Reversal W / M (ฟิลเตอร์ไหล่ 50%)", group = g8)
showRange  = input.bool(true, "แสดง Strong / Weak High-Low หลัง CHoCH", group = g8)
showReAcc  = input.bool(true, "แสดง Re-Accumulation / Re-Distribution", group = g8)

g9 = "Trade Setup / Backtest"
enableTrade = input.bool(true, "เปิด Trade Simulator + ตารางสถิติ", group = g9)
entryMode   = input.string("BB Retest (ทุกสัญญาณ)", "สัญญาณเข้าเทรด", options = ["BB Retest (ทุกสัญญาณ)", "Reaper เท่านั้น"], group = g9)
slMode      = input.string("พ้นโซน BreakBlock", "วิธีวาง SL", options = ["พ้นโซน BreakBlock", "พ้นระดับ CHoCH (ปลอดภัย)"], tooltip = "EP.5/Day Trade: SL พ้นโซน refine หรือพ้น HTF POI/Strong Swing", group = g9)
slBufAtr    = input.float(0.1, "Buffer SL (xATR14)", minval = 0.0, step = 0.05, group = g9)
tpMode      = input.string("Fixed RR", "วิธีตั้ง TP", options = ["Fixed RR", "สวิงล่าสุด (Day Trade)", "Fibo TP1"], group = g9)
rrFixed     = input.float(3.0, "ค่า RR (โหมด Fixed RR)", minval = 0.5, step = 0.5, group = g9)
sameBarLoss = input.bool(true, "แท่งเดียวชน SL+TP = นับแพ้ (conservative)", group = g9)
drawTrade   = input.bool(true, "วาดเส้น Entry / SL / TP", group = g9)
showStats   = input.bool(true, "แสดงตารางสถิติ Win/Loss", group = g9)
statPosS    = input.string("bottom_left", "ตำแหน่งตารางสถิติ", options = ["top_right", "top_left", "bottom_right", "bottom_left"], group = g9)

f_tablePos(s) =>
    s == "top_right" ? position.top_right : s == "top_left" ? position.top_left : s == "bottom_right" ? position.bottom_right : position.bottom_left
dashPos = f_tablePos(dashPosS)
statPos = f_tablePos(statPosS)
atrV    = ta.atr(14)

// ═════════════════════════ GLOBAL STATE / STORAGE ═════════════════════════
// swing detector ขาขึ้น (หา High + HL ตาม checklist valid pullback EP.2)
var float uH   = high
var int   uHb  = 0
var float uHl  = low
var bool  uP   = false
var float uPl  = na
var int   uPlb = 0
var float uPlh = na
var bool  uFvg = false
// swing detector ขาลง (หา Low + LH)
var float dL   = low
var int   dLb  = 0
var float dLh  = high
var bool  dP   = false
var float dPh  = na
var int   dPhb = 0
var float dPhl = na
var bool  dFvg = false
// โครงสร้าง (EP.3)
var int   dir      = 0
var float prevHi   = na
var int   prevHiB  = 0
var float prevLo   = na
var int   prevLoB  = 0
var float prevHi2  = na
var int   prevHi2B = 0
var float prevLo2  = na
var int   prevLo2B = 0
var float idm      = na
var int   idmB     = 0
var float idmTop   = na
var float idmBot   = na
var bool  idmClr   = false
var bool  mssDone  = false
var float chochL   = na
var int   chochB   = 0
var float runMaxH  = high
var int   runMaxHb = 0
var float runMinL  = low
var int   runMinLb = 0
var line  idmLine   = na
var line  chochLine = na
var float chochLPlot = na
// พูลเก็บ drawing เพื่อคุมจำนวน
var label[] swLabels = array.new<label>()
var line[]  stLines  = array.new<line>()
var label[] stLabels = array.new<label>()
// POI zones (EP.4)
var box[]  poiBox = array.new<box>()
var line[] poiMid = array.new<line>()
var int[]  poiDir = array.new<int>()
// BreakBlock รอตรวจ FVG (finalize หลังทริกเกอร์ 3 แท่ง)
var float[] pdTop = array.new<float>()
var float[] pdBot = array.new<float>()
var int[]   pdDir = array.new<int>()
var int[]   pdBar = array.new<int>()
var int[]   pdCnt = array.new<int>()
var bool[]  pdFvg = array.new<bool>()
// BreakBlock zones
var box[]  bbBox  = array.new<box>()
var int[]  bbDir  = array.new<int>()
var bool[] bbHit  = array.new<bool>()
var int[]  bbOvl  = array.new<int>()
var bool[] bbOut  = array.new<bool>()
var bool[] bbStar = array.new<bool>()
var int[]  bbBorn = array.new<int>()
// SR Shadow bands
var box[] srBox = array.new<box>()
var int[] srDir = array.new<int>()
// Fibo (EP.5)
var line[]  fibLines = array.new<line>()
var label[] fibLabs  = array.new<label>()
// Liquidity: BSL/SSL lines (Day Trade)
var line[]  liqHiLn = array.new<line>()
var float[] liqHiLv = array.new<float>()
var line[]  liqLoLn = array.new<line>()
var float[] liqLoLv = array.new<float>()
// Reaper Model / Re-Acc-Re-Dist
var float slRetail    = na
var line  slLine      = na
var float neckLvl     = na
var bool  neckTouched = false
var int   neckB       = 0
// Trade simulator (backtest)
var bool  tActive = false
var int   tDir    = 0
var float tEntry  = na
var float tSL     = na
var float tTP     = na
var int   tEntryB = 0
var bool  tReaper = false
var line  tEntryLn = na
var line  tSLLn    = na
var line  tTPLn    = na
var label tRRLab   = na
var line[]  tHist = array.new<line>()
// สถิติสะสม
var int   nTrades = 0
var int   nWin    = 0
var int   nLoss   = 0
var int   nWinL   = 0
var int   nWinS   = 0
var int   nLossL  = 0
var int   nLossS  = 0
var float grossWinR  = 0.0
var float grossLossR = 0.0
var float sumR       = 0.0
var int   streak     = 0
var int   bestWinStk  = 0
var int   worstLosStk = 0
// เก็บ geometry ของโซนที่ทริกเกอร์ retest (ไว้ตั้ง SL)
var float sigTop = na
var float sigBot = na
// anchor ของ Fibo ล่าสุด (ไว้คำนวณ TP โหมด Fibo TP1)
var float fibA = na
var float fibB = na

// ═════════════════════════ HELPER FUNCTIONS ═════════════════════════
f_addLabel(lb) =>
    array.push(swLabels, lb)
    if array.size(swLabels) > 200
        label.delete(array.shift(swLabels))

f_addLine(ln, lb) =>
    array.push(stLines, ln)
    array.push(stLabels, lb)
    if array.size(stLines) > 120
        line.delete(array.shift(stLines))
        label.delete(array.shift(stLabels))

f_poiAdd(d, top, bot, leftBar) =>
    if top > bot
        b = box.new(leftBar, top, bar_index, bot, border_color = color.new(colPoi, 55), bgcolor = color.new(colPoi, 88), text = "POI", text_color = color.new(colPoi, 30), text_size = size.tiny, text_halign = text.align_right)
        m = line.new(leftBar, (top + bot) / 2, bar_index, (top + bot) / 2, color = color.new(colPoi, 35), style = line.style_dashed)
        array.push(poiBox, b)
        array.push(poiMid, m)
        array.push(poiDir, d)
        if array.size(poiBox) > 3
            box.delete(array.shift(poiBox))
            line.delete(array.shift(poiMid))
            array.shift(poiDir)

f_pendAdd(d, top, bot, leftBar, fvg0) =>
    if top > bot
        array.push(pdTop, top)
        array.push(pdBot, bot)
        array.push(pdDir, d)
        array.push(pdBar, leftBar)
        array.push(pdCnt, 3)
        array.push(pdFvg, fvg0)

f_srOverlap(top, bot) =>
    ov = false
    k = 0
    while k < array.size(srBox)
        sb = array.get(srBox, k)
        if not (bot > box.get_top(sb) or top < box.get_bottom(sb))
            ov := true
        k += 1
    ov

f_bbCreate(d, top, bot, leftBar) =>
    // EP.4: OVERLAP กับ SR Shadow = ประสิทธิภาพสูงขึ้น → ติดดาว
    star = f_srOverlap(top, bot)
    col  = d == 1 ? colBBBull : colBBBear
    b = box.new(leftBar, top, bar_index, bot, border_color = color.new(col, 40), bgcolor = color.new(col, 82), text = star ? "BB ★" : "BB", text_color = color.new(col, 20), text_size = size.tiny, text_halign = text.align_right)
    array.push(bbBox, b)
    array.push(bbDir, d)
    array.push(bbHit, false)
    array.push(bbOvl, 0)
    array.push(bbOut, false)
    array.push(bbStar, star)
    array.push(bbBorn, bar_index)
    if array.size(bbBox) > maxBB
        box.delete(array.shift(bbBox))
        array.shift(bbDir)
        array.shift(bbHit)
        array.shift(bbOvl)
        array.shift(bbOut)
        array.shift(bbStar)
        array.shift(bbBorn)

f_fibClear() =>
    while array.size(fibLines) > 0
        line.delete(array.pop(fibLines))
    while array.size(fibLabs) > 0
        label.delete(array.pop(fibLabs))

f_statCell(t, r, k, v, vc) =>
    table.cell(t, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_right)

f_fibDraw(a, b) =>
    // ลาก 1 ที่จุด A (สวิงกลางที่ถูกเบรก) และ 0 ที่จุด B (extreme)
    // ชุด EP.5: TP1=4.123, TP2=6 / ชุด W-M (Breakblock_S): TP 300%/400%/600%
    f_fibClear()
    ep5   = fibPreset == "4.123 / 6 (EP.5)"
    ks    = ep5 ? array.from(0.0, 1.0, 4.123, 4.618, 6.0, 6.444, 6.918) : array.from(0.0, 1.0, 3.0, 4.0, 6.0)
    names = ep5 ? array.from("0", "1", "TP1  4.123", "4.618", "TP2  6", "6.444", "6.918") : array.from("0", "1", "TP1  300%", "TP2  400%", "TP3  600%")
    for i = 0 to array.size(ks) - 1
        minor = ep5 and (i == 3 or i == 5 or i == 6)
        anchor = i == 0 or i == 1
        if not minor or showMinorFib
            p  = b + (a - b) * array.get(ks, i)
            ln = line.new(bar_index, p, bar_index + 8, p, color = color.new(colFib, minor or anchor ? 65 : 25), width = minor or anchor ? 1 : 2, extend = extend.right)
            lb = label.new(bar_index + 8, p, array.get(names, i), style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(colFib, minor or anchor ? 45 : 0), size = size.tiny)
            array.push(fibLines, ln)
            array.push(fibLabs, lb)

// state machine แบบย่อ (ไม่มีการวาด) สำหรับ HTF bias บน dashboard
f_dir() =>
    var float _uH  = high
    var float _uHl = low
    var bool  _uP  = false
    var float _uPl = na
    var float _dL  = low
    var float _dLh = high
    var bool  _dP  = false
    var float _dPh = na
    var int   _dir = 0
    var float _idm = na
    var bool  _clr = false
    var float _cho = na
    var float _mxH = high
    var float _mnL = low
    _upC = false
    _dnC = false
    if not _uP
        if high > _uH
            _uH  := high
            _uHl := low
        if low < _uHl
            _uP  := true
            _uPl := low
    else
        if low < _uPl
            _uPl := low
        if useCloseBreak ? close > _uH : high > _uH
            _upC := true
    if not _dP
        if low < _dL
            _dL  := low
            _dLh := high
        if high > _dLh
            _dP  := true
            _dPh := high
    else
        if high > _dPh
            _dPh := high
        if useCloseBreak ? close < _dL : low < _dL
            _dnC := true
    if high > _mxH
        _mxH := high
    if low < _mnL
        _mnL := low
    if _dir == 1
        if not _clr and not na(_idm) and low < _idm
            _clr := true
        if not na(_cho) and close < _cho
            _dir := -1
            _cho := _mxH
            _mxH := high
            _mnL := low
            _idm := na
            _clr := false
    else if _dir == -1
        if not _clr and not na(_idm) and high > _idm
            _clr := true
        if not na(_cho) and close > _cho
            _dir := 1
            _cho := _mnL
            _mxH := high
            _mnL := low
            _idm := na
            _clr := false
    if _upC
        if _dir == 0
            _dir := 1
        if _dir == 1
            if _clr or na(_cho)
                _cho := _uPl
            _idm := _uPl
            _clr := false
        _uH  := high
        _uHl := low
        _uP  := false
        _uPl := na
    if _dnC
        if _dir == 0
            _dir := -1
        if _dir == -1
            if _clr or na(_cho)
                _cho := _dPh
            _idm := _dPh
            _clr := false
        _dL  := low
        _dLh := high
        _dP  := false
        _dPh := na
    _dir

htf1Dir = request.security(syminfo.tickerid, htf1, f_dir(), lookahead = barmerge.lookahead_off)
htf2Dir = request.security(syminfo.tickerid, htf2, f_dir(), lookahead = barmerge.lookahead_off)

// ═════════════════════════ ENGINE — ต่อแท่ง ═════════════════════════
// FVG มาตรฐาน 3 แท่ง (EP.5: "แท่ง imbalance สร้างช่องว่างของราคา")
bullFvg = low > high[2]
bearFvg = high < low[2]

// extreme สะสมของขาปัจจุบัน (ใช้เป็นจุด B ของ Fibo ตอนเกิด CHoCH)
if high > runMaxH
    runMaxH  := high
    runMaxHb := bar_index
if low < runMinL
    runMinL  := low
    runMinLb := bar_index

// ── ตัวตรวจ Valid Pullback (EP.2/EP.3) ──
// ขาขึ้น: 1) แท่งทำ HIGH สูงสุดรวมไส้  2) LOW ของแท่งนั้นโดนเบรก  3) เบรก HIGH กลับ
upConf = false
dnConf = false

if not uP
    if high > uH
        uH  := high
        uHb := bar_index
        uHl := low
    if low < uHl
        uP   := true
        uPl  := low
        uPlb := bar_index
        uPlh := high
else
    if low < uPl
        uPl  := low
        uPlb := bar_index
        uPlh := high
    if bullFvg
        uFvg := true
    if useCloseBreak ? close > uH : high > uH
        upConf := true

if not dP
    if low < dL
        dL  := low
        dLb := bar_index
        dLh := high
    if high > dLh
        dP   := true
        dPh  := high
        dPhb := bar_index
        dPhl := low
else
    if high > dPh
        dPh  := high
        dPhb := bar_index
        dPhl := low
    if bearFvg
        dFvg := true
    if useCloseBreak ? close < dL : low < dL
        dnConf := true

// ── เหตุการณ์ระดับแท่ง: IDM sweep → MSS → CHoCH (EP.3/EP.4) ──
evBosUp    = false
evBosDn    = false
evChoUp    = false
evChoDn    = false
evMssUp    = false
evMssDn    = false
evSweep    = false
retestBuy  = false
retestSell = false
reaperBuy  = false
reaperSell = false
evPatW     = false
evPatM     = false
canConfirm = not confClose or barstate.isconfirmed

if dir == 1
    // เคลียร์ IDM ด้วยไส้ (EP.2: ยืนยัน High ของ External)
    if not idmClr and not na(idm) and low < idm
        idmClr  := true
        evSweep := true
        if showIDM and not na(idmLine)
            line.set_x2(idmLine, bar_index)
            f_addLine(idmLine, label.new(bar_index, idm, "IDM ✕", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colIdm, size = size.tiny))
            idmLine := na
        // Reaper Phase B: pullback โดนเคลียร์ → ระดับนี้คือ Stoploss Retail
        if showReaper
            slRetail := idm
            if not na(slLine)
                line.delete(slLine)
            slLine := line.new(idmB, idm, bar_index, idm, color = color.new(color.red, 25), width = 1)
            f_addLabel(label.new(bar_index, idm, "SL Retail", style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(color.red, 25), size = size.tiny))
    // MSS ขาลง = ปิดทะลุ pivot (IDM ถูกทำลาย → เกิด BreakBlock ฝั่งตรงข้าม, EP.4)
    if not mssDone and not na(idm) and close < idm and canConfirm
        evMssDn := true
        mssDone := true
        if showMSS
            f_addLine(line.new(idmB, idm, bar_index, idm, color = colBear, width = 2), label.new(bar_index, idm, "MSS", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colBear, size = size.small))
        if showPOI and not na(prevHi) and prevHi > idm
            f_poiAdd(-1, prevHi, idm, idmB)
        if showBB and not na(idmTop)
            f_pendAdd(-1, idmTop, idmBot, idmB, false)
    // CHoCH ขาลง = ปิดทะลุจุดกำเนิด Strong Swing (EP.3: ต้องปิดแท่งทะลุไส้)
    if not na(chochL) and close < chochL and canConfirm
        evChoDn := true
        if showCHoCH
            f_addLine(line.new(chochB, chochL, bar_index, chochL, color = colBear, width = 2), label.new(bar_index, chochL, "CHoCH", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colBear, size = size.small))
        fibA := chochL
        fibB := runMaxH
        if showFib and runMaxH > chochL
            f_fibDraw(chochL, runMaxH)
        // Pattern Reversal M (Breakblock_S): ไหล่อีกลูกต้องอยู่สูงกว่า 50% ของช่วง Low→High
        if showWM
            shoulder  = runMaxH == prevHi ? prevHi2 : prevHi
            shoulderB = runMaxH == prevHi ? prevHi2B : prevHiB
            mid50     = chochL + (runMaxH - chochL) * 0.5
            if not na(shoulder) and shoulder > mid50
                evPatM := true
                f_addLabel(label.new(shoulderB, shoulder, "M ✓", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colBear, size = size.small))
        // Range (Day Trade): จุดสูงสุด = Strong High ควรยัน, เป้า = Weak Low (ERL)
        if showRange
            f_addLabel(label.new(runMaxHb, runMaxH, "Strong High", style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(colBear, 35), size = size.tiny))
            if not na(prevLo)
                f_addLabel(label.new(prevLoB, prevLo, "Weak Low (ERL)", style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(colBear, 45), size = size.tiny))
        // Neckline สำหรับ Re-Distribution = ระดับที่ถูกเบรก
        neckLvl     := chochL
        neckTouched := false
        neckB       := bar_index
        slRetail    := na
        if not na(slLine)
            line.delete(slLine)
            slLine := na
        dir      := -1
        chochL   := runMaxH
        chochB   := runMaxHb
        runMaxH  := high
        runMaxHb := bar_index
        runMinL  := low
        runMinLb := bar_index
        idm      := na
        idmClr   := false
        mssDone  := false
        if not na(idmLine)
            line.delete(idmLine)
            idmLine := na
else if dir == -1
    if not idmClr and not na(idm) and high > idm
        idmClr  := true
        evSweep := true
        if showIDM and not na(idmLine)
            line.set_x2(idmLine, bar_index)
            f_addLine(idmLine, label.new(bar_index, idm, "IDM ✕", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colIdm, size = size.tiny))
            idmLine := na
        if showReaper
            slRetail := idm
            if not na(slLine)
                line.delete(slLine)
            slLine := line.new(idmB, idm, bar_index, idm, color = color.new(color.red, 25), width = 1)
            f_addLabel(label.new(bar_index, idm, "SL Retail", style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(color.red, 25), size = size.tiny))
    if not mssDone and not na(idm) and close > idm and canConfirm
        evMssUp := true
        mssDone := true
        if showMSS
            f_addLine(line.new(idmB, idm, bar_index, idm, color = colBull, width = 2), label.new(bar_index, idm, "MSS", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colBull, size = size.small))
        if showPOI and not na(prevLo) and idm > prevLo
            f_poiAdd(1, idm, prevLo, idmB)
        if showBB and not na(idmTop)
            f_pendAdd(1, idmTop, idmBot, idmB, false)
    if not na(chochL) and close > chochL and canConfirm
        evChoUp := true
        if showCHoCH
            f_addLine(line.new(chochB, chochL, bar_index, chochL, color = colBull, width = 2), label.new(bar_index, chochL, "CHoCH", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colBull, size = size.small))
        fibA := chochL
        fibB := runMinL
        if showFib and chochL > runMinL
            f_fibDraw(chochL, runMinL)
        // Pattern Reversal W (Breakblock_S): ไหล่อีกลูกต้องอยู่ต่ำกว่า 50% ของช่วง High→Low
        if showWM
            shoulder  = runMinL == prevLo ? prevLo2 : prevLo
            shoulderB = runMinL == prevLo ? prevLo2B : prevLoB
            mid50     = runMinL + (chochL - runMinL) * 0.5
            if not na(shoulder) and shoulder < mid50
                evPatW := true
                f_addLabel(label.new(shoulderB, shoulder, "W ✓", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colBull, size = size.small))
        if showRange
            f_addLabel(label.new(runMinLb, runMinL, "Strong Low", style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(colBull, 35), size = size.tiny))
            if not na(prevHi)
                f_addLabel(label.new(prevHiB, prevHi, "Weak High (ERL)", style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(colBull, 45), size = size.tiny))
        // Neckline สำหรับ Re-Accumulation = ระดับที่ถูกเบรก
        neckLvl     := chochL
        neckTouched := false
        neckB       := bar_index
        slRetail    := na
        if not na(slLine)
            line.delete(slLine)
            slLine := na
        dir      := 1
        chochL   := runMinL
        chochB   := runMinLb
        runMaxH  := high
        runMaxHb := bar_index
        runMinL  := low
        runMinLb := bar_index
        idm      := na
        idmClr   := false
        mssDone  := false
        if not na(idmLine)
            line.delete(idmLine)
            idmLine := na

// Reaper: ต่ออายุเส้น Stoploss Retail / ตรวจการแตะ neckline (Re-Acc / Re-Dist)
if not na(slLine)
    line.set_x2(slLine, bar_index)
if not na(neckLvl) and bar_index > neckB
    if dir == 1 and low <= neckLvl
        neckTouched := true
    if dir == -1 and high >= neckLvl
        neckTouched := true

// ── ประมวลผล swing ที่ยืนยันแล้ว (labels EP.1, BOS + IDM ใหม่ EP.2-3, โซน T1 EP.4-5) ──
if upConf
    withTrend = dir >= 0
    if showSwing and (withTrend or showInternal)
        hTxt = na(prevHi) or uH >= prevHi ? "HH" : "LH"
        lTxt = na(prevLo) or uPl >= prevLo ? "HL" : "LL"
        sz   = withTrend ? size.small : size.tiny
        cH   = withTrend ? colBull : color.gray
        f_addLabel(label.new(uHb, uH, hTxt, style = label.style_label_down, color = color.new(color.black, 100), textcolor = cH, size = sz))
        f_addLabel(label.new(uPlb, uPl, lTxt, style = label.style_label_up, color = color.new(color.black, 100), textcolor = cH, size = sz))
    prevHi2  := prevHi
    prevHi2B := prevHiB
    prevLo2  := prevLo
    prevLo2B := prevLoB
    prevHi  := uH
    prevHiB := uHb
    prevLo  := uPl
    prevLoB := uPlb
    if dir == 0
        dir := 1
    if dir == 1
        evBosUp := true
        if showBOS
            f_addLine(line.new(uHb, uH, bar_index, uH, color = colBull, width = 1), label.new(bar_index, uH, "BOS", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colBull, size = size.tiny))
        // Re-Accumulation: หลัง CHoCH ขึ้น ราคาย่อลงหลอกแตะ neckline แล้วทำ BOS ใหม่
        if showReAcc and neckTouched and not na(neckLvl)
            f_addLabel(label.new(uPlb, uPl, "Re-Acc ✓", style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.new(colBull, 20), size = size.tiny))
            neckLvl     := na
            neckTouched := false
        // Strong Swing: pullback ที่เคลียร์ IDM เดิม → จุดกำเนิดคือระดับ CHoCH ใหม่ (EP.3)
        if idmClr or na(chochL)
            chochL := uPl
            chochB := uPlb
        // IDM ย้ายไปสวิงล่าสุดเสมอ (EP.2)
        if showIDM
            if not na(idmLine)
                line.delete(idmLine)
            idmLine := line.new(uPlb, uPl, bar_index, uPl, color = colIdm, style = line.style_dotted, width = 1)
        idm     := uPl
        idmB    := uPlb
        idmTop  := uPlh
        idmBot  := uPl
        idmClr  := false
        mssDone := false
        // T1: โครงสร้างเบรกขึ้นผ่านโซน pullback → BreakBlock ฝั่ง Bull (EP.4 หน้า 13 / EP.5)
        if showBB
            f_pendAdd(1, uPlh, uPl, uPlb, uFvg)
    uH   := high
    uHb  := bar_index
    uHl  := low
    uP   := false
    uPl  := na
    uFvg := false

if dnConf
    withTrend = dir <= 0
    if showSwing and (withTrend or showInternal)
        lTxt = na(prevLo) or dL <= prevLo ? "LL" : "HL"
        hTxt = na(prevHi) or dPh <= prevHi ? "LH" : "HH"
        sz   = withTrend ? size.small : size.tiny
        cH   = withTrend ? colBear : color.gray
        f_addLabel(label.new(dLb, dL, lTxt, style = label.style_label_up, color = color.new(color.black, 100), textcolor = cH, size = sz))
        f_addLabel(label.new(dPhb, dPh, hTxt, style = label.style_label_down, color = color.new(color.black, 100), textcolor = cH, size = sz))
    prevHi2  := prevHi
    prevHi2B := prevHiB
    prevLo2  := prevLo
    prevLo2B := prevLoB
    prevLo  := dL
    prevLoB := dLb
    prevHi  := dPh
    prevHiB := dPhb
    if dir == 0
        dir := -1
    if dir == -1
        evBosDn := true
        if showBOS
            f_addLine(line.new(dLb, dL, bar_index, dL, color = colBear, width = 1), label.new(bar_index, dL, "BOS", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colBear, size = size.tiny))
        // Re-Distribution: หลัง CHoCH ลง ราคาย่อขึ้นหลอกแตะ neckline แล้วทำ BOS ใหม่
        if showReAcc and neckTouched and not na(neckLvl)
            f_addLabel(label.new(dPhb, dPh, "Re-Dist ✓", style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(colBear, 20), size = size.tiny))
            neckLvl     := na
            neckTouched := false
        if idmClr or na(chochL)
            chochL := dPh
            chochB := dPhb
        if showIDM
            if not na(idmLine)
                line.delete(idmLine)
            idmLine := line.new(dPhb, dPh, bar_index, dPh, color = colIdm, style = line.style_dotted, width = 1)
        idm     := dPh
        idmB    := dPhb
        idmTop  := dPh
        idmBot  := dPhl
        idmClr  := false
        mssDone := false
        if showBB
            f_pendAdd(-1, dPh, dPhl, dPhb, dFvg)
    dL   := low
    dLb  := bar_index
    dLh  := high
    dP   := false
    dPh  := na
    dFvg := false

// เส้นเฝ้าระวังระดับ CHoCH ปัจจุบัน (จุดกำเนิด Strong Swing)
if showCHoCH and not na(chochL)
    if na(chochLine) or chochL != chochLPlot
        if not na(chochLine)
            line.delete(chochLine)
        chochLine  := line.new(chochB, chochL, bar_index + 1, chochL, color = color.new(dir == 1 ? colBear : colBull, 30), style = line.style_dashed, width = 1)
        chochLPlot := chochL
    else
        line.set_x2(chochLine, bar_index + 1)
// ต่ออายุเส้น IDM ที่ยังไม่ถูก sweep
if showIDM and not na(idmLine)
    line.set_x2(idmLine, bar_index)

// ── SR Shadow (EP.4): ช่องว่างของ line chart — ตีความเป็น gap ระหว่าง body ──
bodyTop0 = math.max(open, close)
bodyBot0 = math.min(open, close)
bodyTop2 = math.max(open[2], close[2])
bodyBot2 = math.min(open[2], close[2])
if showSR and bodyBot0 - bodyTop2 > srMinAtr * atrV
    b = box.new(bar_index - 2, bodyBot0, bar_index, bodyTop2, border_color = color.new(colSR, 70), bgcolor = color.new(colSR, 90), text = "SR", text_color = color.new(colSR, 45), text_size = size.tiny, text_halign = text.align_right)
    array.push(srBox, b)
    array.push(srDir, 1)
    if array.size(srBox) > maxSR
        box.delete(array.shift(srBox))
        array.shift(srDir)
if showSR and bodyBot2 - bodyTop0 > srMinAtr * atrV
    b = box.new(bar_index - 2, bodyBot2, bar_index, bodyTop0, border_color = color.new(colSR, 70), bgcolor = color.new(colSR, 90), text = "SR", text_color = color.new(colSR, 45), text_size = size.tiny, text_halign = text.align_right)
    array.push(srBox, b)
    array.push(srDir, -1)
    if array.size(srBox) > maxSR
        box.delete(array.shift(srBox))
        array.shift(srDir)

i3 = 0
while i3 < array.size(srBox)
    sb = array.get(srBox, i3)
    sd = array.get(srDir, i3)
    if sd == 1 ? close < box.get_bottom(sb) : close > box.get_top(sb)
        box.delete(sb)
        array.remove(srBox, i3)
        array.remove(srDir, i3)
    else
        box.set_right(sb, bar_index)
        i3 += 1

// ── finalize โซน BreakBlock ที่รอตรวจ FVG (EP.5: FVG คือ CONFIRM ว่าโซนมีพลัง) ──
i1 = 0
while i1 < array.size(pdDir)
    pdd = array.get(pdDir, i1)
    fv  = array.get(pdFvg, i1)
    if pdd == 1 and bullFvg
        fv := true
    if pdd == -1 and bearFvg
        fv := true
    array.set(pdFvg, i1, fv)
    cnt = array.get(pdCnt, i1) - 1
    if cnt <= 0
        if fv or not requireFVG
            f_bbCreate(pdd, array.get(pdTop, i1), array.get(pdBot, i1), array.get(pdBar, i1))
        array.remove(pdTop, i1)
        array.remove(pdBot, i1)
        array.remove(pdDir, i1)
        array.remove(pdBar, i1)
        array.remove(pdCnt, i1)
        array.remove(pdFvg, i1)
    else
        array.set(pdCnt, i1, cnt)
        i1 += 1

// ── จัดการโซน BreakBlock: นับ Overlap (Day Trade: ≥2 = BREAKBLOCK แท้) + retest ตามเทรนด์ ──
i2 = 0
while i2 < array.size(bbDir)
    bb   = array.get(bbBox, i2)
    bd   = array.get(bbDir, i2)
    bt   = box.get_top(bb)
    bbot = box.get_bottom(bb)
    out  = bd == 1 ? close < bbot : close > bt
    ovl  = array.get(bbOvl, i2)
    if out and not array.get(bbOut, i2)
        ovl += 1
        array.set(bbOvl, i2, ovl)
    array.set(bbOut, i2, out)
    if ovl > maxOvl or bar_index - array.get(bbBorn, i2) > zoneAge
        box.delete(bb)
        array.remove(bbBox, i2)
        array.remove(bbDir, i2)
        array.remove(bbHit, i2)
        array.remove(bbOvl, i2)
        array.remove(bbOut, i2)
        array.remove(bbStar, i2)
        array.remove(bbBorn, i2)
    else
        box.set_right(bb, bar_index)
        baseTxt = array.get(bbStar, i2) ? "BB ★" : "BB"
        box.set_text(bb, ovl > 0 ? baseTxt + " ×" + str.tostring(ovl) : baseTxt)
        if not array.get(bbHit, i2)
            touched = bd == 1 ? low <= bt and close > bbot : high >= bbot and close < bt
            if touched and bd == dir
                array.set(bbHit, i2, true)
                sigTop := bt
                sigBot := bbot
                if bd == 1
                    retestBuy := true
                    // Reaper Phase C: retest โซน Bull ที่ราคาลงไปต่ำกว่า Stoploss Retail
                    if not na(slRetail) and low < slRetail
                        reaperBuy := true
                else
                    retestSell := true
                    if not na(slRetail) and high > slRetail
                        reaperSell := true
        i2 += 1

// ── จัดการ POI zones ──
i0 = 0
while i0 < array.size(poiBox)
    pb = array.get(poiBox, i0)
    pd = array.get(poiDir, i0)
    if pd == -1 ? close > box.get_top(pb) : close < box.get_bottom(pb)
        box.delete(pb)
        line.delete(array.get(poiMid, i0))
        array.remove(poiBox, i0)
        array.remove(poiMid, i0)
        array.remove(poiDir, i0)
    else
        box.set_right(pb, bar_index)
        line.set_x2(array.get(poiMid, i0), bar_index)
        i0 += 1

// ── Liquidity (Day Trade): สวิง 3 แท่งรวมไส้ → เส้น BSL/SSL จนกว่าจะโดน sweep + EQH/EQL ──
ph = ta.pivothigh(1, 1)
pl = ta.pivotlow(1, 1)
if showLiq and not na(ph)
    if showEQ and array.size(liqHiLv) > 0 and math.abs(ph - array.get(liqHiLv, array.size(liqHiLv) - 1)) <= eqTol * atrV
        f_addLabel(label.new(bar_index - 1, ph, "EQH $$$", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colLiq, size = size.tiny))
    array.push(liqHiLn, line.new(bar_index - 1, ph, bar_index, ph, color = color.new(colLiq, 45), style = line.style_dotted))
    array.push(liqHiLv, ph)
    if array.size(liqHiLn) > maxLiq
        line.delete(array.shift(liqHiLn))
        array.shift(liqHiLv)
if showLiq and not na(pl)
    if showEQ and array.size(liqLoLv) > 0 and math.abs(pl - array.get(liqLoLv, array.size(liqLoLv) - 1)) <= eqTol * atrV
        f_addLabel(label.new(bar_index - 1, pl, "EQL $$$", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colLiq, size = size.tiny))
    array.push(liqLoLn, line.new(bar_index - 1, pl, bar_index, pl, color = color.new(colLiq, 45), style = line.style_dotted))
    array.push(liqLoLv, pl)
    if array.size(liqLoLn) > maxLiq
        line.delete(array.shift(liqLoLn))
        array.shift(liqLoLv)
iH = 0
while iH < array.size(liqHiLn)
    lvH = array.get(liqHiLv, iH)
    if high > lvH
        lnH = array.get(liqHiLn, iH)
        line.set_x2(lnH, bar_index)
        f_addLine(lnH, label.new(bar_index, lvH, "BSL ✕", style = label.style_label_down, color = color.new(color.black, 100), textcolor = colLiq, size = size.tiny))
        array.remove(liqHiLn, iH)
        array.remove(liqHiLv, iH)
    else
        line.set_x2(array.get(liqHiLn, iH), bar_index)
        iH += 1
iS = 0
while iS < array.size(liqLoLn)
    lvS = array.get(liqLoLv, iS)
    if low < lvS
        lnS = array.get(liqLoLn, iS)
        line.set_x2(lnS, bar_index)
        f_addLine(lnS, label.new(bar_index, lvS, "SSL ✕", style = label.style_label_up, color = color.new(color.black, 100), textcolor = colLiq, size = size.tiny))
        array.remove(liqLoLn, iS)
        array.remove(liqLoLv, iS)
    else
        line.set_x2(array.get(liqLoLn, iS), bar_index)
        iS += 1

// ═════════════════════════ TRADE SIMULATOR / BACKTEST ═════════════════════════
// กฎ Entry/SL/TP สังเคราะห์จากไฟล์: Entry = retest โซน BreakBlock (proximal),
// SL = พ้นโซนฝั่ง distal (+buffer) หรือพ้น CHoCH/Strong Swing, TP = Fixed RR /
// สวิงล่าสุด (Day Trade) / Fibo TP1 (EP.5 4.123 หรือ W-M 300%). เดินย้อนหลังทีละแท่ง
// เพื่อดูว่า TP หรือ SL โดนก่อน แล้วสะสมสถิติ Win/Loss
tExitWin = false
tExitLos = false

// 1) ตรวจการปิดของเทรดที่เปิดอยู่ (เช็คจากแท่งถัดจากแท่งเข้า)
if enableTrade and tActive and bar_index > tEntryB
    hitSL = tDir == 1 ? low <= tSL : high >= tSL
    hitTP = tDir == 1 ? high >= tTP : low <= tTP
    if hitSL or hitTP
        win  = hitTP and (not hitSL or not sameBarLoss)
        rMag = tDir == 1 ? (tTP - tEntry) / (tEntry - tSL) : (tEntry - tTP) / (tSL - tEntry)
        nTrades += 1
        if win
            nWin      += 1
            grossWinR += rMag
            sumR      += rMag
            streak    := streak > 0 ? streak + 1 : 1
            tExitWin  := true
            if tDir == 1
                nWinL += 1
            else
                nWinS += 1
        else
            nLoss      += 1
            grossLossR += 1.0
            sumR       -= 1.0
            streak     := streak < 0 ? streak - 1 : -1
            tExitLos   := true
            if tDir == 1
                nLossL += 1
            else
                nLossS += 1
        bestWinStk  := math.max(bestWinStk, streak)
        worstLosStk := math.min(worstLosStk, streak)
        if drawTrade and not na(tEntryLn)
            line.set_x2(tEntryLn, bar_index)
            line.set_x2(tSLLn, bar_index)
            line.set_x2(tTPLn, bar_index)
            oCol = win ? color.green : color.red
            oTx  = win ? "✓ +" + str.tostring(rMag, "#.0") + "R" : "✗ -1R"
            f_addLabel(label.new(bar_index, win ? tTP : tSL, oTx, style = label.style_label_left, color = color.new(color.black, 100), textcolor = oCol, size = size.tiny))
        tActive := false

// 2) เปิดเทรดใหม่เมื่อมีสัญญาณและไม่มีเทรดค้าง
sigLong  = entryMode == "Reaper เท่านั้น" ? reaperBuy  : retestBuy
sigShort = entryMode == "Reaper เท่านั้น" ? reaperSell : retestSell
if enableTrade and not tActive and (sigLong or sigShort) and not na(sigTop) and not na(sigBot)
    dirT   = sigLong ? 1 : -1
    entryP = close
    buffer = slBufAtr * atrV
    safeSL = slMode == "พ้นระดับ CHoCH (ปลอดภัย)" and not na(chochL)
    slP    = dirT == 1 ? (safeSL ? math.min(sigBot, chochL) : sigBot) - buffer : (safeSL ? math.max(sigTop, chochL) : sigTop) + buffer
    risk   = dirT == 1 ? entryP - slP : slP - entryP
    if risk > 0
        mult = fibPreset == "4.123 / 6 (EP.5)" ? 4.123 : 3.0
        tpP  = entryP + dirT * rrFixed * risk
        if tpMode == "สวิงล่าสุด (Day Trade)"
            cand  = dirT == 1 ? prevHi : prevLo
            valid = not na(cand) and (dirT == 1 ? cand > entryP + risk * 0.5 : cand < entryP - risk * 0.5)
            tpP := valid ? cand : entryP + dirT * rrFixed * risk
        else if tpMode == "Fibo TP1"
            fibTP = not na(fibA) and not na(fibB) ? fibB + (fibA - fibB) * mult : na
            valid = not na(fibTP) and (dirT == 1 ? fibTP > entryP + risk * 0.5 : fibTP < entryP - risk * 0.5)
            tpP := valid ? fibTP : entryP + dirT * rrFixed * risk
        tActive := true
        tDir    := dirT
        tEntry  := entryP
        tSL     := slP
        tTP     := tpP
        tEntryB := bar_index
        tReaper := dirT == 1 ? reaperBuy : reaperSell
        if drawTrade
            rrShow  = dirT == 1 ? (tpP - entryP) / (entryP - slP) : (entryP - tpP) / (slP - entryP)
            tEntryLn := line.new(bar_index, entryP, bar_index + 1, entryP, color = color.new(color.gray, 15), width = 1)
            tSLLn    := line.new(bar_index, slP, bar_index + 1, slP, color = color.new(color.red, 5), style = line.style_dashed, width = 1)
            tTPLn    := line.new(bar_index, tpP, bar_index + 1, tpP, color = color.new(color.green, 5), style = line.style_dashed, width = 1)
            array.push(tHist, tEntryLn)
            array.push(tHist, tSLLn)
            array.push(tHist, tTPLn)
            while array.size(tHist) > 90
                line.delete(array.shift(tHist))
            f_addLabel(label.new(bar_index, tpP, "TP " + str.tostring(rrShow, "#.0") + "R", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(color.green, 0), size = size.tiny))

// ต่ออายุเส้นเทรดที่เปิดอยู่
if enableTrade and tActive and drawTrade and not na(tEntryLn)
    line.set_x2(tEntryLn, bar_index + 1)
    line.set_x2(tSLLn, bar_index + 1)
    line.set_x2(tTPLn, bar_index + 1)

// ═════════════════════════ SIGNALS / ALERTS / DASHBOARD ═════════════════════════
plotshape(showSignals and evChoUp, "CHoCH Up", style = shape.triangleup, location = location.belowbar, color = colBull, size = size.tiny)
plotshape(showSignals and evChoDn, "CHoCH Down", style = shape.triangledown, location = location.abovebar, color = colBear, size = size.tiny)
plotshape(showSignals and retestBuy, "BB Retest Buy", style = shape.circle, location = location.belowbar, color = colBull, size = size.tiny)
plotshape(showSignals and retestSell, "BB Retest Sell", style = shape.circle, location = location.abovebar, color = colBear, size = size.tiny)
plotshape(showSignals and reaperBuy, "Reaper Buy", style = shape.diamond, location = location.belowbar, color = colBull, size = size.small)
plotshape(showSignals and reaperSell, "Reaper Sell", style = shape.diamond, location = location.abovebar, color = colBear, size = size.small)

alertcondition(evBosUp, "BOS Up", "BreakBlock: BOS ขาขึ้น — โครงสร้างเทรนด์ขึ้นต่อเนื่อง")
alertcondition(evBosDn, "BOS Down", "BreakBlock: BOS ขาลง — โครงสร้างเทรนด์ลงต่อเนื่อง")
alertcondition(evMssUp, "MSS Bullish", "BreakBlock: MSS ขาขึ้น — ปิดทะลุ pivot, เริ่มมีสัญญาณกลับตัวขึ้น (รอ BOS ยืนยัน)")
alertcondition(evMssDn, "MSS Bearish", "BreakBlock: MSS ขาลง — ปิดทะลุ pivot, เริ่มมีสัญญาณกลับตัวลง (รอ BOS ยืนยัน)")
alertcondition(evChoUp, "CHoCH Up", "BreakBlock: CHoCH ขาขึ้น — ปิดแท่งทะลุจุดกำเนิด Strong Swing")
alertcondition(evChoDn, "CHoCH Down", "BreakBlock: CHoCH ขาลง — ปิดแท่งทะลุจุดกำเนิด Strong Swing")
alertcondition(evSweep, "IDM Swept", "BreakBlock: IDM ถูกเคลียร์ (sweep) — ยืนยัน High/Low ของ External")
alertcondition(retestBuy, "BB Retest Buy", "BreakBlock: ราคากลับมาทดสอบโซน Bull BreakBlock ตามเทรนด์")
alertcondition(retestSell, "BB Retest Sell", "BreakBlock: ราคากลับมาทดสอบโซน Bear BreakBlock ตามเทรนด์")
alertcondition(reaperBuy, "Reaper Buy", "BreakBlock: Reaper Buy — retest โซน Bull ต่ำกว่า Stoploss Retail")
alertcondition(reaperSell, "Reaper Sell", "BreakBlock: Reaper Sell — retest โซน Bear เหนือ Stoploss Retail")
alertcondition(evPatW, "Pattern W", "BreakBlock: Pattern Reversal W ยืนยัน (ไหล่ต่ำกว่า 50%)")
alertcondition(evPatM, "Pattern M", "BreakBlock: Pattern Reversal M ยืนยัน (ไหล่สูงกว่า 50%)")
alertcondition(tExitWin, "Trade Win", "BreakBlock: เทรดปิดกำไร — ชน TP")
alertcondition(tExitLos, "Trade Loss", "BreakBlock: เทรดปิดขาดทุน — ชน SL")

var table dash = table.new(dashPos, 2, 7, bgcolor = color.new(color.black, 78), border_width = 1, border_color = color.new(color.gray, 72))
if showDash and barstate.islast
    trTxt = dir == 1 ? "UP ▲" : dir == -1 ? "DOWN ▼" : "—"
    trCol = dir == 1 ? colBull : dir == -1 ? colBear : color.gray
    table.cell(dash, 0, 0, "Trend", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, trTxt, text_color = trCol, text_size = size.small)
    idmTxt = na(idm) ? "—" : str.tostring(idm, format.mintick) + (idmClr ? "  ✕" : "")
    table.cell(dash, 0, 1, "IDM", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 1, idmTxt, text_color = colIdm, text_size = size.small)
    choTxt = na(chochL) ? "—" : str.tostring(chochL, format.mintick)
    table.cell(dash, 0, 2, "CHoCH lvl", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 2, choTxt, text_color = dir == 1 ? colBear : colBull, text_size = size.small)
    h1Txt = htf1Dir == 1 ? "▲" : htf1Dir == -1 ? "▼" : "—"
    h1Col = htf1Dir == 1 ? colBull : htf1Dir == -1 ? colBear : color.gray
    table.cell(dash, 0, 3, "HTF " + htf1, text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 3, h1Txt, text_color = h1Col, text_size = size.small)
    h2Txt = htf2Dir == 1 ? "▲" : htf2Dir == -1 ? "▼" : "—"
    h2Col = htf2Dir == 1 ? colBull : htf2Dir == -1 ? colBear : color.gray
    table.cell(dash, 0, 4, "HTF " + htf2, text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 4, h2Txt, text_color = h2Col, text_size = size.small)
    table.cell(dash, 0, 5, "Zones", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(array.size(bbBox)) + " BB / " + str.tostring(array.size(srBox)) + " SR", text_color = color.silver, text_size = size.small)
    slTxt = na(slRetail) ? "—" : str.tostring(slRetail, format.mintick)
    table.cell(dash, 0, 6, "SL Retail", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 6, slTxt, text_color = color.new(color.red, 20), text_size = size.small)

// ── ตารางสถิติ Win/Loss ย้อนหลัง (Backtest) ──
var table stat = table.new(statPos, 2, 11, bgcolor = color.new(color.black, 80), border_width = 1, border_color = color.new(color.gray, 72))
if enableTrade and showStats and barstate.islast
    winRate = nTrades > 0 ? nWin / nTrades * 100 : 0.0
    avgWin  = nWin  > 0 ? grossWinR / nWin : 0.0
    pf      = grossLossR > 0 ? grossWinR / grossLossR : (grossWinR > 0 ? 999.0 : 0.0)
    wrCol   = winRate >= 50 ? colBull : winRate >= 35 ? color.orange : colBear
    netCol  = sumR >= 0 ? colBull : colBear
    table.cell(stat, 0, 0, "BreakBlock Backtest", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(stat, 1, 0, tpMode == "Fixed RR" ? str.tostring(rrFixed, "#.0") + "R" : tpMode == "Fibo TP1" ? "Fibo" : "Swing", text_color = color.new(color.white, 20), text_size = size.small, text_halign = text.align_right)
    f_statCell(stat, 1, "Trades", str.tostring(nTrades), color.white)
    f_statCell(stat, 2, "Win / Loss", str.tostring(nWin) + " / " + str.tostring(nLoss), color.white)
    f_statCell(stat, 3, "Win Rate", str.tostring(winRate, "#.0") + "%", wrCol)
    f_statCell(stat, 4, "Avg Win", str.tostring(avgWin, "#.00") + "R", colBull)
    f_statCell(stat, 5, "Profit Factor", str.tostring(pf, "#.00"), pf >= 1 ? colBull : colBear)
    f_statCell(stat, 6, "Net R", (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.0") + "R", netCol)
    f_statCell(stat, 7, "Long W/L", str.tostring(nWinL) + " / " + str.tostring(nLossL), color.new(colBull, 15))
    f_statCell(stat, 8, "Short W/L", str.tostring(nWinS) + " / " + str.tostring(nLossS), color.new(colBear, 15))
    f_statCell(stat, 9, "Best Win Streak", str.tostring(bestWinStk), colBull)
    f_statCell(stat, 10, "Worst Loss Streak", str.tostring(worstLosStk), colBear)
